[user]
	name = Joe Rozner
	email = joe@deadbytes.net
[init]
	defaultBranch = main
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[rebase]
	autoStash = true
	autoSquash = true
	updateRefs = true
[rerere]
	enabled = true
[diff]
	algorithm = histogram
	colorMoved = default
[merge]
	conflictStyle = zdiff3
[branch]
	sort = -committerdate
[tag]
	sort = version:refname
[grep]
	lineNumber = true
[help]
	autocorrect = prompt
